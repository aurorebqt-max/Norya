# Server variables ONLY, set in Vercel. Never prefix these with EXPO_PUBLIC_.
NORYA_TRANSLATE_ENABLED=false
NORYA_APP_ORIGIN=https://your-norya-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=configure-on-server
NORYA_ADMIN_USER_ID=uuid-of-the-only-confirmed-admin-account
TRANSLATE_API_URL=https://your-translate-domain.example
TRANSLATE_SHARED_SECRET=configure-a-random-secret-of-at-least-32-bytes
# Public feature flag: not a credential. Requires rebuilding the static application.
EXPO_PUBLIC_NORYA_TRANSLATE_ENABLED=false
